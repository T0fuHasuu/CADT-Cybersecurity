<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Simple NodeJS WebApp</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/static/images/favicon.png" />
    <link href="https://cdn.jsdelivr.net/npm/bootswatch@5.2.3/dist/cerulean/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Anton&display=swap" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="/static/css/main.css" />
</head>

<body>
    <nav>
        <a href="/">Index</a>
        <a href="/ping">Ping Your Machine</a>
        <a href="/logout">Logout</a>
    </nav> 

    <div class="container">
        <h1 class="text-center my-5">Simple NodeJS WebApp</h1>
        <div class="row">
        <h2>Update your profile:<h2>
        </div>
    </div>

    <form id="form" method="POST">
            <label for="deviceIP">Device IP</label>
            <input type="text" id="deviceIP" name="deviceIP" />
            <br />
            <label for="password">Password</label>
            <input
                type="password"
                id="password"
                name="password"
                autocomplete="off"
            />
            <br />
            <button type="submit">Update</button>
            <div class="error-message" id="error-message">{^{: error }}</div>
        </form>

    <script src="/static/js/main.js"></script>
</body>

</html>